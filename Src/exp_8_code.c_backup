#include "main.h"
#include "stm32f4xx_hal.h"
#include "stm32f429i_discovery_lcd.h"
#include "stm32f429i_discovery_ts.h"
#include <stdio.h>

// --- Our Trained AI Weights ---
#include "model_data.h"

// --- Configuration ---
#define DRAW_AREA_SIZE 240
#define MNIST_SIZE 28
#define TOUCH_TIMEOUT_MS 1500

// --- Globals ---
float mnist_input[784];
uint32_t last_touch_time = 0;
uint8_t is_drawing = 0;

// --- Function Prototypes ---
void SystemClock_Config(void);
void Error_Handler(void);
void DrawClearButton(void);
void I2C_ClearBus(void);
void CenterDigit(float* grid);
int PredictDigit(float* input_784);

// ==========================================================
// 1. THE PREPROCESSING ALGORITH
// ==========================================================
void CenterDigit(float* grid) {
    int min_x = 28, max_x = 0, min_y = 28, max_y = 0;
    int pixel_count = 0;

    // Find the bounding box of the drawing
    for(int y=0; y<28; y++) {
        for(int x=0; x<28; x++) {
            if(grid[y*28+x] > 0.1f) {
                if(x < min_x) min_x = x;
                if(x > max_x) max_x = x;
                if(y < min_y) min_y = y;
                if(y > max_y) max_y = y;
                pixel_count++;
            }
        }
    }

    if(pixel_count == 0 || min_x > max_x) return;

    // Calculate how far off-center the drawing is
    int width = max_x - min_x + 1;
    int height = max_y - min_y + 1;
    int shift_x = 14 - (min_x + (width / 2));
    int shift_y = 14 - (min_y + (height / 2));

    // Create a temporary grid and shift the pixels
    float temp_grid[784] = {0};
    for(int y=0; y<28; y++) {
        for(int x=0; x<28; x++) {
            int new_x = x + shift_x;
            int new_y = y + shift_y;

            if(new_x >= 0 && new_x < 28 && new_y >= 0 && new_y < 28) {
                temp_grid[new_y*28 + new_x] = grid[y*28 + x];
            }
        }
    }

    // Overwrite the original grid with the perfectly centered one
    for(int i=0; i<784; i++) {
        grid[i] = temp_grid[i];
    }
}

// ==========================================================
// 2. THE NEURAL NETWORK (Inference)
// ==========================================================
int PredictDigit(float* input_784) {
    float hidden_layer[64];
    float output_layer[10];

    // Forward Pass: Hidden Layer (Dense 64 + ReLU)
    for (int i = 0; i < 64; i++) {
        float sum = b1[i];
        for (int j = 0; j < 784; j++) {
            sum += input_784[j] * W1[j * 64 + i];
        }
        hidden_layer[i] = (sum > 0.0f) ? sum : 0.0f; // ReLU Activation
    }

    // Forward Pass: Output Layer (Dense 10)
    for (int i = 0; i < 10; i++) {
        float sum = b2[i];
        for (int j = 0; j < 64; j++) {
            sum += hidden_layer[j] * W2[j * 10 + i];
        }
        output_layer[i] = sum;
    }

    // ArgMax: Find the highest probability
    int max_index = 0;
    float max_val = output_layer[0];
    for (int i = 1; i < 10; i++) {
        if (output_layer[i] > max_val) {
            max_val = output_layer[i];
            max_index = i;
        }
    }
    return max_index;
}

// ==========================================================
// 3. HARDWARE FIX (I2C Un-sticker)
// ==========================================================
void I2C_ClearBus(void) {
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Pin = GPIO_PIN_8;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_OD;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);
    GPIO_InitStruct.Pin = GPIO_PIN_9;
    HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_9, GPIO_PIN_SET);
    HAL_Delay(1);
    for (int i = 0; i < 9; i++) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);
        HAL_Delay(1);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);
        HAL_Delay(1);
    }
}

// ==========================================================
// 4. MAIN PROGRAM & UI LOGIC
// ==========================================================
int main(void) {
    HAL_Init();
    SystemClock_Config();

    BSP_LCD_Init();
    BSP_LCD_LayerDefaultInit(1, LCD_FRAME_BUFFER);
    BSP_LCD_SelectLayer(1);
    BSP_LCD_Clear(LCD_COLOR_WHITE);

    I2C_ClearBus();

    if (BSP_TS_Init(BSP_LCD_GetXSize(), BSP_LCD_GetYSize()) != TS_OK) {
        BSP_LCD_SetTextColor(LCD_COLOR_RED);
        BSP_LCD_DisplayStringAt(0, 150, (uint8_t *)"Touch Init Failed", CENTER_MODE);
        Error_Handler();
    }

    DrawClearButton();
    for(int i=0; i<784; i++) mnist_input[i] = 0.0f;
    TS_StateTypeDef TS_State;

    while (1) {
        BSP_TS_GetState(&TS_State);

        // --- Drawing Logic ---
        if (TS_State.TouchDetected) {
            uint16_t x = TS_State.X;
            uint16_t y = BSP_LCD_GetYSize() - TS_State.Y; // Inverted Y fix!

            if (x > 160 && y < 40) {
                // Clear Button Logic
                BSP_LCD_Clear(LCD_COLOR_WHITE);
                DrawClearButton();
                for(int i=0; i<784; i++) mnist_input[i] = 0.0f;
                is_drawing = 0;
                HAL_Delay(200);
            }
            else if (y < DRAW_AREA_SIZE) {
                // Drawing on Canvas
                is_drawing = 1;
                last_touch_time = HAL_GetTick();

                BSP_LCD_SetTextColor(LCD_COLOR_BLUE);
                BSP_LCD_FillCircle(x, y, 4);

                // Map physical pixels to 28x28 ML Grid
                int grid_x = (x * MNIST_SIZE) / DRAW_AREA_SIZE;
                int grid_y = (y * MNIST_SIZE) / DRAW_AREA_SIZE;

                if (grid_x > 0 && grid_x < MNIST_SIZE-1 && grid_y > 0 && grid_y < MNIST_SIZE-1) {
                    mnist_input[(grid_y * MNIST_SIZE) + grid_x] = 1.0f;
                    // Simulating a thicker pen brush for the AI
                    mnist_input[(grid_y * MNIST_SIZE) + grid_x + 1] = 0.8f;
                    mnist_input[(grid_y * MNIST_SIZE) + grid_x - 1] = 0.8f;
                    mnist_input[((grid_y+1) * MNIST_SIZE) + grid_x] = 0.8f;
                    mnist_input[((grid_y-1) * MNIST_SIZE) + grid_x] = 0.8f;
                }
            }
        }

        // --- Inference Trigger ---
        if (is_drawing && (HAL_GetTick() - last_touch_time > TOUCH_TIMEOUT_MS)) {

            BSP_LCD_SetTextColor(LCD_COLOR_MAGENTA);
            BSP_LCD_SetFont(&Font16);
            BSP_LCD_DisplayStringAt(0, 255, (uint8_t *)"Predicting...", CENTER_MODE);

            // 1. Center the drawing
            CenterDigit(mnist_input);

            // 2. Run the AI Prediction
            int prediction = PredictDigit(mnist_input);

            // 3. Display Results
            char result_str[32];
            sprintf(result_str, " I see a: %d! ", prediction);
            BSP_LCD_SetTextColor(LCD_COLOR_DARKGREEN);
            BSP_LCD_SetFont(&Font24);
            BSP_LCD_DisplayStringAt(0, 280, (uint8_t *)result_str, CENTER_MODE);

            is_drawing = 0;
        }
    }
}

void DrawClearButton(void) {
    BSP_LCD_SetTextColor(LCD_COLOR_RED);
    BSP_LCD_FillRect(160, 0, 80, 40);
    BSP_LCD_SetTextColor(LCD_COLOR_WHITE);
    BSP_LCD_SetBackColor(LCD_COLOR_RED);
    BSP_LCD_SetFont(&Font16);
    BSP_LCD_DisplayStringAt(170, 12, (uint8_t *)"CLEAR", LEFT_MODE);
    BSP_LCD_SetBackColor(LCD_COLOR_WHITE);
    BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
    BSP_LCD_DrawLine(0, 240, 240, 240);
}

void SystemClock_Config(void) {
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};
  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 8;
  RCC_OscInitStruct.PLL.PLLN = 360;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = 7;
  HAL_RCC_OscConfig(&RCC_OscInitStruct);
  HAL_PWREx_EnableOverDrive();
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK|RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;
  HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5);
}

void Error_Handler(void) { while(1){} }
